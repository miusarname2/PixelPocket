        TextOut(50, 8, ">POT");
    else
        TextOut(50, 8, " POT");
    if (questAction == 3)
        TextOut(75, 8, ">MAG");
    else
        TextOut(75, 8, " MAG");
    TextOut(1, 0, "POT");
    NumOut(22, 0, questPotions);
    TextOut(39, 0, "MP");
    NumOut(55, 0, questMP);
    TextOut(77, 0, "W");
    NumOut(87, 0, questWins);
}

void ResetEnemy()
{
    if (shots % 5 == 0)
    {
        enemyX = 4;
        enemyY = 1;
    }
    else if (shots % 5 == 1)
    {
        enemyX = 6;
        enemyY = 3;
    }
    else if (shots % 5 == 2)
    {
        enemyX = 1;
        enemyY = 3;
    }
    else if (shots % 5 == 3)
    {
        enemyX = 4;
        enemyY = 2;
    }
    else
    {
        enemyX = 2;
        enemyY = 3;
    }

    if (heroX == enemyX && heroY == enemyY)
        enemyX = 6;
}

void EnemyTurn()
{
    int testX;
    int testY;

    testX = enemyX;
    testY = enemyY;
    if (heroX > enemyX)
        testX++;
    else if (heroX < enemyX)
        testX--;
    else if (heroY > enemyY)
        testY++;
    else if (heroY < enemyY)
        testY--;

    if (ArenaWall(testX, testY))
    {
        testX = enemyX;
        testY = enemyY;
        if (heroY > enemyY)
            testY++;
        else if (heroY < enemyY)
            testY--;
    }
    if (!ArenaWall(testX, testY))
    {
        enemyX = testX;
        enemyY = testY;
    }

    if (enemyX == heroX && enemyY == heroY)
    {
        lives--;
        PlayTone(180, 120);
        heroX = 1;
        heroY = 1;
        ResetEnemy();
    }
}

void FireBlaster()
{
    if (EnemyDistance() > 0)
    {
        shots++;
        PlayTone(990, 100);
        ResetEnemy();
    }
    else
        PlayTone(330, 45);
}

void PlayMiniQuest()
{
    bool actionUsed;

    ResetMusic();
    playerHP = 10;
    questWins = 0;
    questPotions = 3;
    questMP = 4;
    questAction = 0;

    while (playerHP > 0 && questWins < 4)
    {
        enemyHP = 4 + questWins * 2;
        while (playerHP > 0 && enemyHP > 0)
        {
            DrawQuestBattle();

            if (ButtonPressed(BTNLEFT, false) ||
                ButtonPressed(BTNRIGHT, false))
            {
                questAction = (questAction + 1) % 4;
                PlayTone(500, 35);
                Wait(180);
            }

            if (ButtonPressed(BTNCENTER, false))
            {
                while (ButtonPressed(BTNCENTER, false))
                    Wait(25);

                actionUsed = false;
                if (questAction == 0)
                {
                    enemyHP = enemyHP - 3;
                    PlayTone(760, 70);
                    if (enemyHP < 0)
                        enemyHP = 0;
                    actionUsed = true;
                }
                else if (questAction == 1)
                {
                    actionUsed = true;
                    PlayTone(440, 70);
                }
                else if (questAction == 2 && questPotions > 0)
                {
                    questPotions--;
                    playerHP = playerHP + 4;
                    if (playerHP > 10)
                        playerHP = 10;
                    PlayTone(990, 100);
                    actionUsed = true;
                }
                else if (questAction == 3 && questMP >= 2)
                {
                    questMP = questMP - 2;
                    enemyHP = enemyHP - 5;
                    if (enemyHP < 0)
                        enemyHP = 0;
                    PlayTone(880, 120);
                    actionUsed = true;
                }
                else
                    PlayTone(220, 80);

                if (actionUsed && enemyHP > 0)
                {
                    questDamage = 1 + questWins;
                    if (questAction == 1)
                        questDamage = questDamage - 2;
                    if (questDamage < 1)
                        questDamage = 1;
                    playerHP = playerHP - questDamage;
                    if (playerHP < 0)
                        playerHP = 0;
                    PlayTone(180, 100);
                }
                Wait(220);
            }

            if (ButtonPressed(BTNEXIT, false))
            {
                while (ButtonPressed(BTNEXIT, false))
                    Wait(25);
                return;
            }
            MusicTick(1, 9);
            Wait(35);
        }

        if (playerHP > 0)
        {
            questWins++;
            if (questPotions < 3)
                questPotions++;
            questMP = questMP + 2;
            if (questMP > 4)
                questMP = 4;
            ClearScreen();
            TextOut(23, 42, "FOE DEFEATED");
            TextOut(17, 33, "POTION +1  MP +2");
            if (questWins < 4)
            {
                TextOut(17, 26, "NEXT BATTLE:");
                NumOut(80, 26, questWins + 1);
                TextOut(9, 8, "ENTER: CONTINUE");
            }
            else
                TextOut(19, 8, "ENTER: FINISH");
            PlayTone(880, 150);
            while (!ButtonPressed(BTNCENTER, false))
                Wait(25);
            while (ButtonPressed(BTNCENTER, false))
                Wait(25);
        }
    }

    ClearScreen();
    if (questWins >= 4)
        TextOut(19, 42, "QUEST COMPLETE");
    else
        TextOut(21, 42, "PARTY RESTS");
    TextOut(20, 26, "BATTLES:");
    NumOut(67, 26, questWins);
    TextOut(8, 6, "ENTER:MENU");
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

bool PlatformContains(int x, int surface)
{
    if (surface == 4)
        return true;
    if (surface == 18 && x >= 12 && x <= 42)
        return true;
    if (surface == 32 && x >= 38 && x <= 68)
        return true;
    if (surface == 46 && x >= 64 && x <= 94)
        return true;
    return false;
}

int FindLanding(int x, int oldY, int newY)
{
    if (oldY >= 46 && newY <= 46 && PlatformContains(x, 46))
        return 46;
    if (oldY >= 32 && newY <= 32 && PlatformContains(x, 32))
        return 32;
    if (oldY >= 18 && newY <= 18 && PlatformContains(x, 18))
        return 18;
    if (oldY >= 4 && newY <= 4)
        return 4;
    return -1;
}

bool IsSupported(int x, int y)
{
    if (y == 4 || (y == 18 && PlatformContains(x, 18)) ||
        (y == 32 && PlatformContains(x, 32)) ||
        (y == 46 && PlatformContains(x, 46)))
        return true;
    return false;
}

void DrawPlatform(int x1, int x2, int surface)
{
    LineOut(x1, surface, x2, surface);
    LineOut(x1, surface + 1, x2, surface + 1);
    LineOut(x1 + 2, surface - 2, x2 - 2, surface - 2);

    while (x1 + 5 < x2)
    {
        LineOut(x1 + 5, surface + 2, x1 + 7, surface + 2);
        x1 = x1 + 10;
    }
}

void DrawBear(int x, int feetY)
{
    RectOut(x + 2, feetY + 1, 5, 5);
    CircleOut(x + 4, feetY + 9, 3);
    CircleOut(x + 1, feetY + 11, 2);
    CircleOut(x + 7, feetY + 11, 2);
    PointOut(x + 3, feetY + 10);
    PointOut(x + 5, feetY + 10);
    CircleOut(x + 4, feetY + 8, 1);
    LineOut(x, feetY + 3, x + 2, feetY + 4);
    LineOut(x + 6, feetY + 4, x + 8, feetY + 3);
    LineOut(x + 2, feetY, x + 3, feetY);
    LineOut(x + 6, feetY, x + 7, feetY);
}

int HeroSpriteRow(int row)
{
    if (row == 0)
        return 0x66;
    if (row == 1)
        return 0x66;
    if (row == 2)
        return 0x3C;
    if (row == 3)
        return 0x7E;
    if (row == 4)
        return 0x7E;
    if (row == 5)
        return 0x3C;
    if (row == 6)
        return 0x7E;
    return 0x3C;
}

int BearSpriteRow(int row)
{
    if (row == 0)
        return 0x66;
    if (row == 1)
        return 0x7E;
    if (row == 2)
        return 0xFF;
    if (row == 3)
        return 0xFF;
    if (row == 4)
        return 0xFF;
    if (row == 5)
        return 0x7E;
    if (row == 6)
        return 0x7E;
    return 0x66;
}

void DrawPixelSprite(int x, int feetY, bool isBear)
{
    int row;
    int column;
    int mask;
    int rows;

    rows = 8;
    for (row = 0; row < rows; row++)
    {
        if (isBear)
            mask = BearSpriteRow(row);
        else
            mask = HeroSpriteRow(row);

        for (column = 0; column < 8; column++)
        {
            if ((mask & (1 << column)) != 0)
                DrawBlock(x + column * 2, feetY + row * 2, 2, 2);
        }
    }

    if (isBear)
    {
        PointOut(x + 4, feetY + 9, DRAW_OPT_CLEAR_PIXELS);
        PointOut(x + 10, feetY + 9, DRAW_OPT_CLEAR_PIXELS);
        DrawBlock(x + 7, feetY + 5, 3, 2);
    }
    else
    {
        PointOut(x + 4, feetY + 11, DRAW_OPT_CLEAR_PIXELS);
        PointOut(x + 10, feetY + 11, DRAW_OPT_CLEAR_PIXELS);
        LineOut(x + 6, feetY + 7, x + 8, feetY + 7);
    }
}

void DrawBarrelRun()
{
    int ladderY;

    ClearScreen();
    TextOut(10, 56, "BEAR RUN");
    TextOut(76, 56, "L");
    NumOut(88, 56, runnerLives);

    DrawPlatform(0, 98, 4);
    DrawPlatform(12, 42, 18);
    DrawPlatform(38, 68, 32);
    DrawPlatform(64, 94, 46);
    LineOut(38, 5, 38, 17);
    LineOut(42, 5, 42, 17);
    for (ladderY = 7; ladderY < 18; ladderY = ladderY + 4)
        LineOut(38, ladderY, 42, ladderY);
    LineOut(58, 19, 58, 31);
    LineOut(62, 19, 62, 31);
    for (ladderY = 21; ladderY < 32; ladderY = ladderY + 4)
        LineOut(58, ladderY, 62, ladderY);
    LineOut(68, 33, 68, 45);
    LineOut(72, 33, 72, 45);
    for (ladderY = 35; ladderY < 46; ladderY = ladderY + 4)
        LineOut(68, ladderY, 72, ladderY);

    DrawPixelSprite(runnerX, runnerY, false);
    DrawPixelSprite(bearX, bearY, true);
    RectOut(barrelX, barrelY, 6, 6);
    LineOut(barrelX + 1, barrelY + 1, barrelX + 4, barrelY + 4);
    LineOut(barrelX + 4, barrelY + 1, barrelX + 1, barrelY + 4);
    DrawBlock(80, 46, 8, 2);
    LineOut(84, 48, 84, 56);
    LineOut(84, 56, 92, 54);
    DrawBlock(85, 50, 5, 2);
}

void ResetBarrel()
{
    barrelX = 61;
    barrelY = 46;
    barrelVY = 0;
    barrelDirection = -1;
}

void PlayBarrelRun()
{
    int oldY;
    int previousRunnerY;
    int landing;
    int gapX;
    int gapY;
    bool wasFalling;

    ResetMusic();
    runnerX = 4;
    runnerY = 4;
    runnerVY = 0;
    runnerLives = 3;
    runnerScore = 0;
    frameCount = 0;
    runnerDone = false;
    bearX = 52;
    bearY = 32;
    bearDirection = -1;
    bearClock = 0;
    ResetBarrel();

    while (runnerLives > 0 && !runnerDone)
    {
        DrawBarrelRun();

        if (ButtonPressed(BTNLEFT, false) && runnerX > 1)
            runnerX = runnerX - 2;
        if (ButtonPressed(BTNRIGHT, false) && runnerX < 80)
            runnerX = runnerX + 2;
        if (ButtonPressed(BTNCENTER, false) && IsSupported(runnerX, runnerY))
        {
            runnerVY = 6;
        }
        if (ButtonPressed(BTNEXIT, false))
        {
            while (ButtonPressed(BTNEXIT, false))
                Wait(25);
            return;
        }

        previousRunnerY = runnerY;
        wasFalling = runnerVY < 0;
        oldY = runnerY;
        runnerY = runnerY + runnerVY;
        if (runnerVY > -8)
            runnerVY--;
        if (runnerY < oldY)
        {
            landing = FindLanding(runnerX, oldY, runnerY);
            if (landing >= 0)
            {
                runnerY = landing;
                runnerVY = 0;
            }
        }
        if (runnerY < 4)
        {
            runnerY = 4;
            runnerVY = 0;
        }

        frameCount++;
        bearClock++;
        if (bearClock >= 6)
        {
            bearClock = 0;
            bearX = bearX + bearDirection * 2;
            if (bearX <= 46)
            {
                bearX = 46;
                bearDirection = 1;
            }
            else if (bearX >= 60)
            {
                bearX = 60;
                bearDirection = -1;
            }
        }

        if (frameCount % 4 == 0)
        {
            barrelX = barrelX + barrelDirection * 2;
            oldY = barrelY;
            if (!IsSupported(barrelX, barrelY))
            {
                barrelY = barrelY + barrelVY;
                if (barrelVY > -8)
                    barrelVY--;
                if (barrelY < oldY)
                {
                    landing = FindLanding(barrelX, oldY, barrelY);
                    if (landing >= 0)
                    {
                        barrelY = landing;
                        barrelVY = 0;
                    }
                }
            }

            if (barrelX < 2)
            {
                barrelDirection = 1;
                barrelX = 2;
            }
            if (barrelX > 92)
            {
                barrelDirection = -1;
                barrelX = 92;
            }
            runnerScore++;
        }

        gapX = runnerX - barrelX;
        gapY = runnerY - barrelY;
        if (gapX < 0)
            gapX = -gapX;
        if (gapY < 0)
            gapY = -gapY;
        if (gapX < 6 && gapY < 7)
        {
            runnerLives--;
            PlayTone(180, 120);
            runnerX = 4;
            runnerY = 4;
            runnerVY = 0;
            ResetBarrel();
        }

        gapX = runnerX - bearX;
        if (gapX < 0)
            gapX = -gapX;
        if (gapX < 10 && wasFalling &&
            previousRunnerY > bearY + 14 && runnerY <= bearY + 14)
        {
            runnerDone = true;
            runnerScore = runnerScore + 100;
            PlayTone(880, 220);
        }
        else if (gapX < 10 && runnerY > bearY - 8 &&
                 runnerY < bearY + 14)
        {
            runnerLives--;
            PlayTone(180, 120);
            runnerX = 4;
            runnerY = 4;
            runnerVY = 0;
            ResetBarrel();
        }

        MusicTick(2, 3);
        Wait(90);
    }

    ClearScreen();
    if (runnerDone)
        TextOut(22, 42, "BEAR BEATEN");
    else
        TextOut(22, 42, "TRY AGAIN");
    TextOut(16, 26, "STEPS:");
    NumOut(58, 26, runnerScore);
    TextOut(8, 6, "ENTER:MENU");
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

void DrawBug(int x, int feetY)
{
    DrawBlock(x + 3, feetY + 2, 8, 5);
    DrawBlock(x + 5, feetY + 7, 4, 2);
    LineOut(x + 4, feetY + 7, x + 2, feetY + 10);
    LineOut(x + 9, feetY + 7, x + 11, feetY + 10);
    LineOut(x + 4, feetY + 3, x + 2, feetY);
    LineOut(x + 9, feetY + 3, x + 11, feetY);
    PointOut(x + 5, feetY + 5, DRAW_OPT_CLEAR_PIXELS);
    PointOut(x + 8, feetY + 5, DRAW_OPT_CLEAR_PIXELS);
}

