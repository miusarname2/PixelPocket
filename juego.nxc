void ResetMusic()
{
    musicCounter = 0;
    musicStep = 0;
}

int MusicNote(int track, int step)
{
    step = step % 8;

    if (track == 0)
    {
        if (step == 0 || step == 4)
            return 659;
        if (step == 1 || step == 7)
            return 784;
        if (step == 2)
            return 880;
        if (step == 3)
            return 784;
        if (step == 5)
            return 587;
        return 659;
    }
    if (track == 1)
    {
        if (step == 0 || step == 7)
            return 392;
        if (step == 1)
            return 494;
        if (step == 2 || step == 6)
            return 587;
        if (step == 3 || step == 5)
            return 659;
        return 784;
    }
    if (track == 2)
    {
        if (step == 0 || step == 5)
            return 523;
        if (step == 1)
            return 659;
        if (step == 2)
            return 784;
        if (step == 3)
            return 698;
        if (step == 4)
            return 659;
        if (step == 6)
            return 587;
        return 698;
    }

    if (step == 0 || step == 5)
        return 587;
    if (step == 1 || step == 6)
        return 698;
    if (step == 2)
        return 880;
    if (step == 3 || step == 7)
        return 784;
    return 659;
}

void MusicTick(int track, int ticksPerNote)
{
    musicCounter++;
    if (musicCounter >= ticksPerNote)
    {
        PlayTone(MusicNote(track, musicStep), 80);
        musicStep = (musicStep + 1) % 8;
        musicCounter = 0;
    }
}

void DrawSongPlayer(int song, int step)
{
    int bar;
    int height;

    ClearScreen();
    TextOut(14, 54, "TUNE BOX");
    TextOut(4, 45, "SELECT SONG");
    if (song == 0)
        TextOut(20, 36, "PIXEL RUN");
    else if (song == 1)
        TextOut(20, 36, "STAR QUEST");
    else if (song == 2)
        TextOut(20, 36, "CAVE LIGHT");
    else
        TextOut(20, 36, "BEEP PARADE");

    for (bar = 0; bar < 8; bar++)
    {
        height = 3 + ((bar * 7 + song * 3) % 10);
        if (bar == step)
            height = height + 4;
        RectOut(10 + bar * 11, 15, 6, height);
    }
    if (step < 0)
    {
        TextOut(4, 7, "L/R: SONG");
        TextOut(4, 0, "ENTER: PLAY");
    }
    else
    {
        TextOut(4, 7, "PLAYING...");
        TextOut(4, 0, "EXIT: STOP");
    }
}

void PlaySongPlayer()
{
    int song;
    int step;
    int repetition;
    bool stopSong;

    song = 0;
    while (true)
    {
        DrawSongPlayer(song, -1);
        if (ButtonPressed(BTNLEFT, false))
        {
            song = (song + 3) % 4;
            PlayTone(500, 35);
            Wait(180);
        }
        else if (ButtonPressed(BTNRIGHT, false))
        {
            song = (song + 1) % 4;
            PlayTone(600, 35);
            Wait(180);
        }
        else if (ButtonPressed(BTNCENTER, false))
        {
            while (ButtonPressed(BTNCENTER, false))
                Wait(25);

            stopSong = false;
            for (repetition = 0; repetition < 2 && !stopSong; repetition++)
            {
                for (step = 0; step < 8 && !stopSong; step++)
                {
                    if (ButtonPressed(BTNEXIT, false))
                    {
                        while (ButtonPressed(BTNEXIT, false))
                            Wait(25);
                        stopSong = true;
                    }
                    else
                    {
                        DrawSongPlayer(song, step);
                        PlayTone(MusicNote(song, step), 110);
                        Wait(145);
                    }
                }
            }
        }
        else if (ButtonPressed(BTNEXIT, false))
        {
            while (ButtonPressed(BTNEXIT, false))
                Wait(25);
            return;
        }
        Wait(35);
    }
}

bool TetrominoCell(int kind, int turn, int x, int y)
{
    int baseX;
    int baseY;

    baseX = x;
    baseY = y;
    if (turn == 1)
    {
        baseX = y;
        baseY = 3 - x;
    }
    else if (turn == 2)
    {
        baseX = 3 - x;
        baseY = 3 - y;
    }
    else if (turn == 3)
    {
        baseX = 3 - y;
        baseY = x;
    }

    if (kind == 0)
        return baseY == 1 && baseX < 4;
    if (kind == 1)
        return (baseY == 1 && (baseX == 1 || baseX == 2)) ||
               (baseY == 2 && (baseX == 1 || baseX == 2));
    if (kind == 2)
        return (baseY == 1 && baseX < 3) ||
               (baseY == 2 && baseX == 1);
    if (kind == 3)
        return (baseY == 1 && baseX == 0) ||
               (baseY == 2 && baseX < 3);
    if (kind == 4)
        return (baseY == 1 && baseX == 2) ||
               (baseY == 2 && baseX < 3);
    if (kind == 5)
        return (baseY == 1 && (baseX == 1 || baseX == 2)) ||
               (baseY == 2 && (baseX == 0 || baseX == 1));

    return (baseY == 1 && (baseX == 0 || baseX == 1)) ||
           (baseY == 2 && (baseX == 1 || baseX == 2));
}

bool TetrisCollision(int testX, int testY, int testRotation)
{
    int x;
    int y;
    int bx;
    int by;

    for (y = 0; y < 4; y++)
    {
        for (x = 0; x < 4; x++)
        {
            if (TetrominoCell(piece, testRotation, x, y))
            {
                bx = testX + x;
                by = testY + y;
                if (bx < 0 || bx >= BOARD_W || by < 0 || by >= BOARD_H)
                    return true;
                if ((boardRows[by] & (1 << bx)) != 0)
                    return true;
            }
        }
    }
    return false;
}

void TetrisSpawn()
{
    piece = (piece + 3) % 7;
    rotation = 0;
    pieceX = 2;
    pieceY = BOARD_H - 3;
    gameOver = TetrisCollision(pieceX, pieceY, rotation);
}

int TetrisClearLines()
{
    int x;
    int y;
    int scanY;
    bool full;
    int cleared;

    cleared = 0;
    scanY = 0;
    while (scanY < BOARD_H)
    {
        full = true;
        for (x = 0; x < BOARD_W; x++)
        {
            if ((boardRows[scanY] & (1 << x)) == 0)
                full = false;
        }

        if (full)
        {
            for (y = scanY; y < BOARD_H - 1; y++)
            {
                boardRows[y] = boardRows[y + 1];
            }
            boardRows[BOARD_H - 1] = 0;
            cleared++;
            clearedLines++;
        }
        else
        {
            scanY++;
        }
    }
    return cleared;
}

void TetrisLock()
{
    int x;
    int y;
    int bx;
    int by;
    int rows;

    if (TetrisCollision(pieceX, pieceY, rotation))
    {
        gameOver = true;
        return;
    }

    for (y = 0; y < 4; y++)
    {
        for (x = 0; x < 4; x++)
        {
            if (TetrominoCell(piece, rotation, x, y))
            {
                bx = pieceX + x;
                by = pieceY + y;
                boardRows[by] = boardRows[by] | (1 << bx);
            }
        }
    }

    rows = TetrisClearLines();
    if (rows > 0)
    {
        score = score + rows * rows * 10;
        PlayTone(880, 90);
    }
    if (!gameOver)
        TetrisSpawn();
}

void DrawBlock(int x, int y, int width, int height)
{
    int row;

    for (row = 0; row < height; row++)
        LineOut(x, y + row, x + width - 1, y + row);
}

void DrawTetris()
{
    int x;
    int y;
    int screenY;

    ClearScreen();
    TextOut(32, 56, "TETRAS");
    RectOut(3, 2, 44, 54);

    for (y = 0; y < BOARD_H; y++)
    {
        screenY = 5 + y * CELL;
        for (x = 0; x < BOARD_W; x++)
        {
            if ((boardRows[y] & (1 << x)) != 0)
                DrawBlock(5 + x * CELL, screenY, CELL - 1, CELL - 1);
        }
    }

    if (!gameOver)
    {
        for (y = 0; y < 4; y++)
        {
            for (x = 0; x < 4; x++)
            {
                if (TetrominoCell(piece, rotation, x, y))
                {
                    screenY = 5 + (pieceY + y) * CELL;
                    if (pieceY + y >= 0 && pieceY + y < BOARD_H)
                        DrawBlock(5 + (pieceX + x) * CELL, screenY,
                                  CELL - 1, CELL - 1);
                }
            }
        }
    }

    TextOut(52, 43, "SCORE");
    NumOut(52, 34, score);
    TextOut(52, 21, "LINES");
    NumOut(52, 12, clearedLines);
    TextOut(52, 3, "EXIT: MENU");
}

void PlayTetris()
{
    int x;
    int y;
    int nextRotation;

    ResetMusic();
    for (y = 0; y < BOARD_H; y++)
        boardRows[y] = 0;

    score = 0;
    clearedLines = 0;
    fallClock = 0;
    piece = 0;
    gameOver = false;
    TetrisSpawn();

    while (!gameOver)
    {
        DrawTetris();

        if (ButtonPressed(BTNLEFT, false) &&
            !TetrisCollision(pieceX - 1, pieceY, rotation))
            pieceX--;
        if (ButtonPressed(BTNRIGHT, false) &&
            !TetrisCollision(pieceX + 1, pieceY, rotation))
            pieceX++;
        if (ButtonPressed(BTNCENTER, false))
        {
            nextRotation = (rotation + 1) % 4;
            if (!TetrisCollision(pieceX, pieceY, nextRotation))
                rotation = nextRotation;
        }
        if (ButtonPressed(BTNEXIT, false))
        {
            while (ButtonPressed(BTNEXIT, false))
                Wait(25);
            return;
        }

        MusicTick(0, 5);
        Wait(60);
        fallClock = fallClock + 60;
        if (fallClock >= 500)
        {
            fallClock = 0;
            if (!TetrisCollision(pieceX, pieceY - 1, rotation))
                pieceY--;
            else
            {
                TetrisLock();
                PlayTone(440, 40);
            }
        }
    }

    ClearScreen();
    TextOut(20, 46, "GAME OVER");
    TextOut(20, 32, "SCORE:");
    NumOut(60, 32, score);
    TextOut(8, 8, "ENTER:MENU");
    PlayTone(220, 250);
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

bool ArenaWall(int x, int y)
{
    if (x < 0 || x >= 8 || y < 0 || y >= 5)
        return true;
    if (x == 0 || x == 7 || y == 0 || y == 4)
        return true;
    if ((x == 3 && y == 2) || (x == 5 && y == 1))
        return true;
    return false;
}

void ShowGameInstructions(int game)
{
    ClearScreen();
    if (game == 0)
    {
        TextOut(24, 52, "TETRAS");
        TextOut(8, 36, "LEFT/RIGHT: MOVE");
        TextOut(8, 24, "ENTER: ROTATE");
        TextOut(8, 12, "EXIT: MENU");
    }
    else if (game == 1)
    {
        TextOut(24, 52, "MINI QUEST");
        TextOut(8, 38, "L/R: CHOOSE");
        TextOut(8, 26, "ENTER: USE");
        TextOut(8, 14, "ATK/DEF/POT/MAG");
    }
    else if (game == 2)
    {
        TextOut(24, 52, "BEAR RUN");
        TextOut(8, 38, "LEFT/RIGHT: RUN");
        TextOut(8, 26, "ENTER: JUMP");
        TextOut(8, 14, "EXIT: MENU");
    }
    else if (game == 3)
    {
        TextOut(24, 52, "SKY HOP");
        TextOut(8, 38, "LEFT/RIGHT: RUN");
        TextOut(8, 26, "ENTER: JUMP");
        TextOut(8, 14, "REACH THE STAR");
    }
    else
    {
        TextOut(28, 52, "TUNE BOX");
        TextOut(8, 38, "L/R: SONG");
        TextOut(8, 26, "ENTER: PLAY");
        TextOut(8, 14, "EXIT: MENU/STOP");
    }
    TextOut(8, 2, "ENTER TO START");
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

int ViewLeft(int depth)
{
    if (depth == 0)
        return 4;
    if (depth == 1)
        return 18;
    if (depth == 2)
        return 30;
    return 40;
}

int ViewRight(int depth)
{
    if (depth == 0)
        return 96;
    if (depth == 1)
        return 82;
    if (depth == 2)
        return 70;
    return 60;
}

int ViewBottom(int depth)
{
    if (depth == 0)
        return 4;
    if (depth == 1)
        return 12;
    if (depth == 2)
        return 18;
    return 22;
}

int ViewTop(int depth)
{
    if (depth == 0)
        return 49;
    if (depth == 1)
        return 41;
    if (depth == 2)
        return 35;
    return 31;
}

void DrawSideWall(int depth, bool leftSide)
{
    int nearDepth;
    int nearX;
    int farX;
    int nearBottom;
    int nearTop;
    int farBottom;
    int farTop;

    nearDepth = depth - 1;
    nearX = ViewLeft(nearDepth);
    farX = ViewLeft(depth);
    nearBottom = ViewBottom(nearDepth);
    nearTop = ViewTop(nearDepth);
    farBottom = ViewBottom(depth);
    farTop = ViewTop(depth);

    if (leftSide)
    {
        LineOut(nearX, nearBottom, farX, farBottom);
        LineOut(nearX, nearTop, farX, farTop);
        LineOut(nearX, nearBottom, nearX, nearTop);
        LineOut(farX, farBottom, farX, farTop);
    }
    else
    {
        nearX = ViewRight(nearDepth);
        farX = ViewRight(depth);
        LineOut(nearX, nearBottom, farX, farBottom);
        LineOut(nearX, nearTop, farX, farTop);
        LineOut(nearX, nearBottom, nearX, nearTop);
        LineOut(farX, farBottom, farX, farTop);
    }
}

void DrawFrontWall(int depth)
{
    int left;
    int right;
    int bottom;
    int top;
    int stripeX;

    left = ViewLeft(depth);
    right = ViewRight(depth);
    bottom = ViewBottom(depth);
    top = ViewTop(depth);
    RectOut(left, bottom, right - left, top - bottom);
    LineOut(left + 3, bottom + 3, right - 3, top - 3);
    LineOut(left + 3, top - 3, right - 3, bottom + 3);
    stripeX = left + 5;
    while (stripeX < right - 3)
    {
        LineOut(stripeX, bottom + 2, stripeX, top - 2);
        stripeX = stripeX + 6;
    }
}

int EnemyDistance()
{
    int distance;
    int testX;
    int testY;

    for (distance = 1; distance <= 3; distance++)
    {
        testX = heroX + heroDX * distance;
        testY = heroY + heroDY * distance;
        if (ArenaWall(testX, testY))
            return 0;
        if (testX == enemyX && testY == enemyY)
            return distance;
    }
    return 0;
}

void DrawEnemyInView(int distance)
{
    int scale;
    int baseY;
    int left;

    if (distance == 1)
    {
        scale = 2;
        baseY = 12;
    }
    else if (distance == 2)
    {
        scale = 1;
        baseY = 17;
    }
    else
    {
        scale = 1;
        baseY = 20;
    }

    left = 50 - 4 * scale;
    DrawBlock(left + 2 * scale, baseY, 4 * scale, scale);
    DrawBlock(left + scale, baseY + scale, 6 * scale, scale);
    DrawBlock(left + scale, baseY + 2 * scale, 6 * scale, 3 * scale);
    DrawBlock(left + 2 * scale, baseY + 5 * scale, 4 * scale, 2 * scale);
    DrawBlock(left, baseY + 6 * scale, 3 * scale, scale);
    DrawBlock(left + 5 * scale, baseY + 6 * scale, 3 * scale, scale);
    PointOut(left + 3 * scale, baseY + 6 * scale, DRAW_OPT_CLEAR_PIXELS);
    PointOut(left + 5 * scale, baseY + 6 * scale, DRAW_OPT_CLEAR_PIXELS);
}

