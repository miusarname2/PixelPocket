    DrawPlatform(0, 98, 4);
    DrawPlatform(12, 42, 18);
    DrawPlatform(38, 68, 32);
    DrawPlatform(64, 94, 46);
    LineOut(38, 5, 38, 17);
    LineOut(42, 5, 42, 17);
    LineOut(58, 19, 58, 31);
    LineOut(62, 19, 62, 31);
    LineOut(68, 33, 68, 45);
    LineOut(72, 33, 72, 45);

    DrawPixelSprite(hopPlayerX, hopPlayerY, false);
    DrawBug(hopEnemyX, 32);
    LineOut(85, 49, 85, 60);
    LineOut(85, 60, 94, 58);
    LineOut(85, 55, 92, 54);
    LineOut(85, 50, 91, 48);
}

void PlaySkyHop()
{
    int oldY;
    int landing;
    int gapX;
    bool wasFalling;

    ResetMusic();
    hopPlayerX = 2;
    hopPlayerY = 4;
    hopPlayerVY = 0;
    hopEnemyX = 52;
    hopEnemyDirection = 1;
    hopEnemyClock = 0;
    hopLives = 3;
    hopScore = 0;
    hopWon = false;
    frameCount = 0;

    while (hopLives > 0 && !hopWon)
    {
        DrawSkyHop();

        if (ButtonPressed(BTNLEFT, false) && hopPlayerX > 1)
            hopPlayerX = hopPlayerX - 2;
        if (ButtonPressed(BTNRIGHT, false) && hopPlayerX < 82)
            hopPlayerX = hopPlayerX + 2;
        if (ButtonPressed(BTNCENTER, false) &&
            IsSupported(hopPlayerX, hopPlayerY))
        {
            hopPlayerVY = 7;
            PlayTone(600, 35);
        }
        if (ButtonPressed(BTNEXIT, false))
        {
            while (ButtonPressed(BTNEXIT, false))
                Wait(25);
            return;
        }

        oldY = hopPlayerY;
        wasFalling = hopPlayerVY < 0;
        hopPlayerY = hopPlayerY + hopPlayerVY;
        if (hopPlayerVY > -8)
            hopPlayerVY--;
        if (hopPlayerY < oldY)
        {
            landing = FindLanding(hopPlayerX, oldY, hopPlayerY);
            if (landing >= 0)
            {
                hopPlayerY = landing;
                hopPlayerVY = 0;
            }
        }
        if (hopPlayerY < 4)
        {
            hopPlayerY = 4;
            hopPlayerVY = 0;
        }

        hopEnemyClock++;
        if (hopEnemyClock >= 5)
        {
            hopEnemyClock = 0;
            hopEnemyX = hopEnemyX + hopEnemyDirection * 2;
            if (hopEnemyX <= 46)
            {
                hopEnemyX = 46;
                hopEnemyDirection = 1;
            }
            else if (hopEnemyX >= 60)
            {
                hopEnemyX = 60;
                hopEnemyDirection = -1;
            }
        }

        gapX = hopPlayerX - hopEnemyX;
        if (gapX < 0)
            gapX = -gapX;
        if (gapX < 10 && wasFalling && oldY > 40 &&
            hopPlayerY <= 40)
        {
            hopScore++;
            PlayTone(880, 120);
            hopEnemyX = 52;
            hopEnemyDirection = 1;
        }
        else if (gapX < 10 && hopPlayerVY <= 0 &&
                 hopPlayerY >= 24 && hopPlayerY < 40)
        {
            hopLives--;
            PlayTone(180, 120);
            hopPlayerX = 2;
            hopPlayerY = 4;
            hopPlayerVY = 0;
        }

        if (hopPlayerX >= 80 && hopPlayerY >= 46)
        {
            hopWon = true;
            PlayTone(990, 180);
        }
        MusicTick(3, 4);
        Wait(75);
    }

    ClearScreen();
    if (hopWon)
        TextOut(21, 42, "STAR REACHED");
    else
        TextOut(22, 42, "TRY AGAIN");
    TextOut(16, 26, "BUGS:");
    NumOut(55, 26, hopScore);
    TextOut(8, 6, "ENTER: MENU");
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

task main()
{
    int selection;
    bool changed;

    selection = 0;
    while (true)
    {
        ClearScreen();
        TextOut(26, 56, "El mejor");
        TextOut(23, 48, "simulador");
        TextOut(23, 40, "de Juegos");
        if (selection == 0)
            TextOut(8, 32, ">");
        TextOut(16, 32, "TETRAS");
        if (selection == 1)
            TextOut(8, 24, ">");
        TextOut(16, 24, "MINI QUEST");
        if (selection == 2)
            TextOut(8, 16, ">");
        TextOut(16, 16, "BEAR RUN");
        if (selection == 3)
            TextOut(8, 8, ">");
        TextOut(16, 8, "SKY HOP");
        if (selection == 4)
            TextOut(8, 0, ">");
        TextOut(16, 0, "TUNE BOX");

        changed = false;
        if (ButtonPressed(BTNLEFT, false))
        {
            selection = (selection + 4) % 5;
            changed = true;
        }
        else if (ButtonPressed(BTNRIGHT, false))
        {
            selection = (selection + 1) % 5;
            changed = true;
        }
        else if (ButtonPressed(BTNCENTER, false))
        {
            while (ButtonPressed(BTNCENTER, false))
                Wait(25);
            ShowGameInstructions(selection);
            if (selection == 0)
                PlayTetris();
            else if (selection == 1)
                PlayMiniQuest();
            else if (selection == 2)
                PlayBarrelRun();
            else if (selection == 3)
                PlaySkyHop();
            else
                PlaySongPlayer();
            changed = true;
        }
        else if (ButtonPressed(BTNEXIT, false))
            Stop(true);

        if (changed)
        {
            Wait(220);
            changed = false;
        }
        Wait(35);
    }
}
