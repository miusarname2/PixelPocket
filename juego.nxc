        TextOut(59, 56, "WISP");
    LineOut(0, 17, 99, 17);
    LineOut(0, 16, 99, 16);
    LineOut(8, 18, 18, 27);
    LineOut(18, 27, 28, 18);
    LineOut(70, 18, 80, 28);
    LineOut(80, 28, 90, 18);
    RectOut(38, 21, 24, 21);
    LineOut(38, 21, 50, 29);
    LineOut(62, 21, 50, 29);
    DrawBlock(20, 20, 6, 5);
    DrawBlock(19, 25, 8, 8);
    DrawBlock(17, 26, 2, 6);
    DrawBlock(27, 26, 2, 6);
    DrawBlock(20, 17, 2, 4);
    DrawBlock(26, 17, 2, 4);
    PointOut(21, 28, DRAW_OPT_CLEAR_PIXELS);
    PointOut(25, 28, DRAW_OPT_CLEAR_PIXELS);

