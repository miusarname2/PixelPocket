const byte BOARD_W = 8;
const byte BOARD_H = 10;
const byte CELL = 5;

byte boardRows[10];
int piece;
int rotation;
int pieceX;
int pieceY;
int score;
int clearedLines;
int fallClock;
bool gameOver;

int heroX;
int heroY;
int heroDX;
int heroDY;
int enemyX;
int enemyY;
int shots;
int lives;
int turnCount;

int runnerX;
int runnerY;
int runnerVY;
int barrelX;
int barrelY;
int barrelVY;
int barrelDirection;
int bearX;
int bearDirection;
int bearClock;
int runnerLives;
int runnerScore;
int frameCount;
bool runnerDone;

bool TetrominoCell(int kind, int turn, int x, int y)
{
    int baseX;
    int baseY;

    baseX = x;
    baseY = y;
    if (turn == 1)
    {
        baseX = y;
        baseY = 3 - x;
    }
    else if (turn == 2)
    {
        baseX = 3 - x;
        baseY = 3 - y;
    }
    else if (turn == 3)
    {
        baseX = 3 - y;
        baseY = x;
    }

    if (kind == 0)
        return baseY == 1 && baseX < 4;
    if (kind == 1)
        return (baseY == 1 && (baseX == 1 || baseX == 2)) ||
               (baseY == 2 && (baseX == 1 || baseX == 2));
    if (kind == 2)
        return (baseY == 1 && baseX < 3) ||
               (baseY == 2 && baseX == 1);
    if (kind == 3)
        return (baseY == 1 && baseX == 0) ||
               (baseY == 2 && baseX < 3);
    if (kind == 4)
        return (baseY == 1 && baseX == 2) ||
               (baseY == 2 && baseX < 3);
    if (kind == 5)
        return (baseY == 1 && (baseX == 1 || baseX == 2)) ||
               (baseY == 2 && (baseX == 0 || baseX == 1));

    return (baseY == 1 && (baseX == 0 || baseX == 1)) ||
           (baseY == 2 && (baseX == 1 || baseX == 2));
}

bool TetrisCollision(int testX, int testY, int testRotation)
{
    int x;
    int y;
    int bx;
    int by;

    for (y = 0; y < 4; y++)
    {
        for (x = 0; x < 4; x++)
        {
            if (TetrominoCell(piece, testRotation, x, y))
            {
                bx = testX + x;
                by = testY + y;
                if (bx < 0 || bx >= BOARD_W || by < 0 || by >= BOARD_H)
                    return true;
                if ((boardRows[by] & (1 << bx)) != 0)
                    return true;
            }
        }
    }
    return false;
}

void TetrisSpawn()
{
    piece = (piece + 3) % 7;
    rotation = 0;
    pieceX = 2;
    pieceY = BOARD_H - 3;
    gameOver = TetrisCollision(pieceX, pieceY, rotation);
}

int TetrisClearLines()
{
    int x;
    int y;
    int scanY;
    bool full;
    int cleared;

    cleared = 0;
    scanY = 0;
    while (scanY < BOARD_H)
    {
        full = true;
        for (x = 0; x < BOARD_W; x++)
        {
            if ((boardRows[scanY] & (1 << x)) == 0)
                full = false;
        }

        if (full)
        {
            for (y = scanY; y < BOARD_H - 1; y++)
            {
                boardRows[y] = boardRows[y + 1];
            }
            boardRows[BOARD_H - 1] = 0;
            cleared++;
            clearedLines++;
        }
        else
        {
            scanY++;
        }
    }
    return cleared;
}

void TetrisLock()
{
    int x;
    int y;
    int bx;
    int by;
    int rows;

    if (TetrisCollision(pieceX, pieceY, rotation))
    {
        gameOver = true;
        return;
    }

    for (y = 0; y < 4; y++)
    {
        for (x = 0; x < 4; x++)
        {
            if (TetrominoCell(piece, rotation, x, y))
            {
                bx = pieceX + x;
                by = pieceY + y;
                boardRows[by] = boardRows[by] | (1 << bx);
            }
        }
    }

    rows = TetrisClearLines();
    if (rows > 0)
    {
        score = score + rows * rows * 10;
        PlayTone(880, 90);
    }
    if (!gameOver)
        TetrisSpawn();
}

void DrawBlock(int x, int y, int width, int height)
{
    int row;

    for (row = 0; row < height; row++)
        LineOut(x, y + row, x + width - 1, y + row);
}

void DrawTetris()
{
    int x;
    int y;
    int screenY;

    ClearScreen();
    TextOut(32, 56, "TETRAS");
    RectOut(3, 2, 44, 54);

    for (y = 0; y < BOARD_H; y++)
    {
        screenY = 5 + y * CELL;
        for (x = 0; x < BOARD_W; x++)
        {
            if ((boardRows[y] & (1 << x)) != 0)
                DrawBlock(5 + x * CELL, screenY, CELL - 1, CELL - 1);
        }
    }

    if (!gameOver)
    {
        for (y = 0; y < 4; y++)
        {
            for (x = 0; x < 4; x++)
            {
                if (TetrominoCell(piece, rotation, x, y))
                {
                    screenY = 5 + (pieceY + y) * CELL;
                    if (pieceY + y >= 0 && pieceY + y < BOARD_H)
                        DrawBlock(5 + (pieceX + x) * CELL, screenY,
                                  CELL - 1, CELL - 1);
                }
            }
        }
    }

    TextOut(52, 43, "SCORE");
    NumOut(52, 34, score);
    TextOut(52, 21, "LINES");
    NumOut(52, 12, clearedLines);
    TextOut(52, 3, "EXIT: MENU");
}

void PlayTetris()
{
    int x;
    int y;
    int nextRotation;

    for (y = 0; y < BOARD_H; y++)
        boardRows[y] = 0;

    score = 0;
    clearedLines = 0;
    fallClock = 0;
    piece = 0;
    gameOver = false;
    TetrisSpawn();

    while (!gameOver)
    {
        DrawTetris();

        if (ButtonPressed(BTNLEFT, false) &&
            !TetrisCollision(pieceX - 1, pieceY, rotation))
            pieceX--;
        if (ButtonPressed(BTNRIGHT, false) &&
            !TetrisCollision(pieceX + 1, pieceY, rotation))
            pieceX++;
        if (ButtonPressed(BTNCENTER, false))
        {
            nextRotation = (rotation + 1) % 4;
            if (!TetrisCollision(pieceX, pieceY, nextRotation))
                rotation = nextRotation;
        }
        if (ButtonPressed(BTNEXIT, false))
        {
            while (ButtonPressed(BTNEXIT, false))
                Wait(25);
            return;
        }

        Wait(60);
        fallClock = fallClock + 60;
        if (fallClock >= 500)
        {
            fallClock = 0;
            if (!TetrisCollision(pieceX, pieceY - 1, rotation))
                pieceY--;
            else
            {
                TetrisLock();
                PlayTone(440, 40);
            }
        }
    }

    ClearScreen();
    TextOut(20, 46, "GAME OVER");
    TextOut(20, 32, "SCORE:");
    NumOut(60, 32, score);
    TextOut(8, 8, "ENTER:MENU");
    PlayTone(220, 250);
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

bool ArenaWall(int x, int y)
{
    if (x < 0 || x >= 8 || y < 0 || y >= 5)
        return true;
    if (x == 0 || x == 7 || y == 0 || y == 4)
        return true;
    if ((x == 3 && y == 2) || (x == 5 && y == 1))
        return true;
    return false;
}

void ShowGameInstructions(int game)
{
    ClearScreen();
    if (game == 0)
    {
        TextOut(24, 52, "TETRAS");
        TextOut(8, 36, "LEFT/RIGHT: MOVE");
        TextOut(8, 24, "ENTER: ROTATE");
        TextOut(8, 12, "EXIT: MENU");
    }
    else if (game == 1)
    {
        TextOut(28, 52, "DUNGEON");
        TextOut(8, 38, "LEFT/RIGHT: TURN");
        TextOut(8, 26, "ENTER: FIRE");
        TextOut(8, 14, "EXIT: FORWARD");
    }
    else
    {
        TextOut(24, 52, "BEAR RUN");
        TextOut(8, 38, "LEFT/RIGHT: RUN");
        TextOut(8, 26, "ENTER: JUMP");
        TextOut(8, 14, "EXIT: MENU");
    }
    TextOut(8, 2, "ENTER TO START");
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

int ViewLeft(int depth)
{
    if (depth == 0)
        return 4;
    if (depth == 1)
        return 18;
    if (depth == 2)
        return 30;
    return 40;
}

int ViewRight(int depth)
{
    if (depth == 0)
        return 96;
    if (depth == 1)
        return 82;
    if (depth == 2)
        return 70;
    return 60;
}

int ViewBottom(int depth)
{
    if (depth == 0)
        return 4;
    if (depth == 1)
        return 12;
    if (depth == 2)
        return 18;
    return 22;
}

int ViewTop(int depth)
{
    if (depth == 0)
        return 49;
    if (depth == 1)
        return 41;
    if (depth == 2)
        return 35;
    return 31;
}

void DrawSideWall(int depth, bool leftSide)
{
    int nearDepth;
    int nearX;
    int farX;
    int nearBottom;
    int nearTop;
    int farBottom;
    int farTop;

    nearDepth = depth - 1;
    nearX = ViewLeft(nearDepth);
    farX = ViewLeft(depth);
    nearBottom = ViewBottom(nearDepth);
    nearTop = ViewTop(nearDepth);
    farBottom = ViewBottom(depth);
    farTop = ViewTop(depth);

    if (leftSide)
    {
        LineOut(nearX, nearBottom, farX, farBottom);
        LineOut(nearX, nearTop, farX, farTop);
        LineOut(nearX, nearBottom, nearX, nearTop);
        LineOut(farX, farBottom, farX, farTop);
    }
    else
    {
        nearX = ViewRight(nearDepth);
        farX = ViewRight(depth);
        LineOut(nearX, nearBottom, farX, farBottom);
        LineOut(nearX, nearTop, farX, farTop);
        LineOut(nearX, nearBottom, nearX, nearTop);
        LineOut(farX, farBottom, farX, farTop);
    }
}

void DrawFrontWall(int depth)
{
    int left;
    int right;
    int bottom;
    int top;
    int stripeX;

    left = ViewLeft(depth);
    right = ViewRight(depth);
    bottom = ViewBottom(depth);
    top = ViewTop(depth);
    RectOut(left, bottom, right - left, top - bottom);
    LineOut(left + 3, bottom + 3, right - 3, top - 3);
    LineOut(left + 3, top - 3, right - 3, bottom + 3);
    stripeX = left + 5;
    while (stripeX < right - 3)
    {
        LineOut(stripeX, bottom + 2, stripeX, top - 2);
        stripeX = stripeX + 6;
    }
}

int EnemyDistance()
{
    int distance;
    int testX;
    int testY;

    for (distance = 1; distance <= 3; distance++)
    {
        testX = heroX + heroDX * distance;
        testY = heroY + heroDY * distance;
        if (ArenaWall(testX, testY))
            return 0;
        if (testX == enemyX && testY == enemyY)
            return distance;
    }
    return 0;
}

void DrawEnemyInView(int distance)
{
    int scale;
    int baseY;
    int left;

    if (distance == 1)
    {
        scale = 2;
        baseY = 12;
    }
    else if (distance == 2)
    {
        scale = 1;
        baseY = 17;
    }
    else
    {
        scale = 1;
        baseY = 20;
    }

    left = 50 - 4 * scale;
    DrawBlock(left + 2 * scale, baseY, 4 * scale, scale);
    DrawBlock(left + scale, baseY + scale, 6 * scale, scale);
    DrawBlock(left + scale, baseY + 2 * scale, 6 * scale, 3 * scale);
    DrawBlock(left + 2 * scale, baseY + 5 * scale, 4 * scale, 2 * scale);
    DrawBlock(left, baseY + 6 * scale, 3 * scale, scale);
    DrawBlock(left + 5 * scale, baseY + 6 * scale, 3 * scale, scale);
    PointOut(left + 3 * scale, baseY + 6 * scale, DRAW_OPT_CLEAR_PIXELS);
    PointOut(left + 5 * scale, baseY + 6 * scale, DRAW_OPT_CLEAR_PIXELS);
}

void DrawArena()
{
    int depth;
    int baseX;
    int baseY;
    int leftX;
    int leftY;
    int rightX;
    int rightY;
    int enemyDepth;
    bool blocked;

    ClearScreen();
    TextOut(28, 56, "DUNGEON");
    LineOut(4, 49, 96, 49);
    LineOut(18, 41, 82, 41);
    LineOut(30, 35, 70, 35);
    LineOut(40, 31, 60, 31);
    LineOut(28, 27, 72, 27);
    LineOut(4, 49, 28, 27);
    LineOut(96, 49, 72, 27);
    LineOut(4, 4, 96, 4);
    LineOut(10, 10, 90, 10);
    LineOut(18, 16, 82, 16);
    LineOut(26, 22, 74, 22);
    LineOut(50, 4, 28, 27);
    LineOut(50, 4, 72, 27);

    blocked = false;
    for (depth = 3; depth > 0; depth--)
    {
        baseX = heroX + heroDX * (depth - 1);
        baseY = heroY + heroDY * (depth - 1);
        leftX = baseX - heroDY;
        leftY = baseY + heroDX;
        rightX = baseX + heroDY;
        rightY = baseY - heroDX;
        if (ArenaWall(leftX, leftY))
            DrawSideWall(depth, true);
        if (ArenaWall(rightX, rightY))
            DrawSideWall(depth, false);

        baseX = heroX + heroDX * depth;
        baseY = heroY + heroDY * depth;
        if (ArenaWall(baseX, baseY))
        {
            DrawFrontWall(depth);
            blocked = true;
            break;
        }
    }

    if (!blocked)
        RectOut(45, 22, 10, 9);

    enemyDepth = EnemyDistance();
    if (enemyDepth > 0)
        DrawEnemyInView(enemyDepth);

    LineOut(46, 26, 49, 26);
    LineOut(51, 26, 54, 26);
    LineOut(50, 23, 50, 25);
    LineOut(50, 27, 50, 29);
    RectOut(42, 4, 16, 8);
    LineOut(44, 10, 50, 16);
    LineOut(56, 10, 50, 16);
    LineOut(45, 5, 48, 5);
    LineOut(52, 5, 55, 5);
    TextOut(1, 0, "HP");
    NumOut(14, 0, lives);
    TextOut(33, 0, "CORES");
    NumOut(68, 0, shots);
}

void ResetEnemy()
{
    if (shots % 5 == 0)
    {
        enemyX = 4;
        enemyY = 1;
    }
    else if (shots % 5 == 1)
    {
        enemyX = 6;
        enemyY = 3;
    }
    else if (shots % 5 == 2)
    {
        enemyX = 1;
        enemyY = 3;
    }
    else if (shots % 5 == 3)
    {
        enemyX = 4;
        enemyY = 2;
    }
    else
    {
        enemyX = 2;
        enemyY = 3;
    }

    if (heroX == enemyX && heroY == enemyY)
        enemyX = 6;
}

void EnemyTurn()
{
    int testX;
    int testY;

    testX = enemyX;
    testY = enemyY;
    if (heroX > enemyX)
        testX++;
    else if (heroX < enemyX)
        testX--;
    else if (heroY > enemyY)
        testY++;
    else if (heroY < enemyY)
        testY--;

    if (ArenaWall(testX, testY))
    {
        testX = enemyX;
        testY = enemyY;
        if (heroY > enemyY)
            testY++;
        else if (heroY < enemyY)
            testY--;
    }
    if (!ArenaWall(testX, testY))
    {
        enemyX = testX;
        enemyY = testY;
    }

    if (enemyX == heroX && enemyY == heroY)
    {
        lives--;
        PlayTone(180, 120);
        heroX = 1;
        heroY = 1;
        ResetEnemy();
    }
}

void FireBlaster()
{
    if (EnemyDistance() > 0)
    {
        shots++;
        PlayTone(990, 100);
        ResetEnemy();
    }
    else
        PlayTone(330, 45);
}

void PlayMazeBlaster()
{
    int nextX;
    int nextY;
    int oldDX;
    int oldDY;
    bool acted;
    bool stepForward;

    heroX = 1;
    heroY = 1;
    heroDX = 1;
    heroDY = 0;
    shots = 0;
    lives = 3;
    turnCount = 0;
    ResetEnemy();

    while (lives > 0 && shots < 5)
    {
        DrawArena();
        acted = false;
        stepForward = false;
        nextX = heroX;
        nextY = heroY;

        if (ButtonPressed(BTNLEFT, false))
        {
            oldDX = heroDX;
            heroDX = -heroDY;
            heroDY = oldDX;
            acted = true;
        }
        else if (ButtonPressed(BTNRIGHT, false))
        {
            oldDX = heroDX;
            heroDX = heroDY;
            heroDY = -oldDX;
            acted = true;
        }
        else if (ButtonPressed(BTNCENTER, false))
        {
            FireBlaster();
            acted = true;
        }
        else if (ButtonPressed(BTNEXIT, false))
        {
            nextX = heroX + heroDX;
            nextY = heroY + heroDY;
            stepForward = true;
            acted = true;
        }

        if (acted)
        {
            if (stepForward)
            {
                if (!ArenaWall(nextX, nextY))
                {
                    heroX = nextX;
                    heroY = nextY;
                    if (heroX == enemyX && heroY == enemyY)
                    {
                        lives--;
                        heroX = 1;
                        heroY = 1;
                        ResetEnemy();
                        PlayTone(180, 120);
                    }
                }
                else
                    PlayTone(220, 40);
            }
            turnCount++;
            if (turnCount % 2 == 0)
                EnemyTurn();
            Wait(220);
        }
    }

    ClearScreen();
    if (shots >= 5)
        TextOut(18, 42, "AREA SECURE");
    else
        TextOut(18, 42, "MISSION LOST");
    TextOut(20, 26, "CORES:");
    NumOut(60, 26, shots);
    TextOut(8, 6, "ENTER:MENU");
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

bool PlatformContains(int x, int surface)
{
    if (surface == 4)
        return true;
    if (surface == 18 && x >= 16 && x <= 56)
        return true;
    if (surface == 32 && x >= 40 && x <= 86)
        return true;
    if (surface == 46 && x >= 12 && x <= 90)
        return true;
    return false;
}

int FindLanding(int x, int oldY, int newY)
{
    if (oldY >= 46 && newY <= 46 && PlatformContains(x, 46))
        return 46;
    if (oldY >= 32 && newY <= 32 && PlatformContains(x, 32))
        return 32;
    if (oldY >= 18 && newY <= 18 && PlatformContains(x, 18))
        return 18;
    if (oldY >= 4 && newY <= 4)
        return 4;
    return -1;
}

bool IsSupported(int x, int y)
{
    if (y == 4 || (y == 18 && PlatformContains(x, 18)) ||
        (y == 32 && PlatformContains(x, 32)) ||
        (y == 46 && PlatformContains(x, 46)))
        return true;
    return false;
}

void DrawPlatform(int x1, int x2, int surface)
{
    LineOut(x1, surface, x2, surface);
    LineOut(x1, surface + 1, x2, surface + 1);
}

void DrawBear(int x, int feetY)
{
    RectOut(x + 2, feetY + 1, 5, 5);
    CircleOut(x + 4, feetY + 9, 3);
    CircleOut(x + 1, feetY + 11, 2);
    CircleOut(x + 7, feetY + 11, 2);
    PointOut(x + 3, feetY + 10);
    PointOut(x + 5, feetY + 10);
    CircleOut(x + 4, feetY + 8, 1);
    LineOut(x, feetY + 3, x + 2, feetY + 4);
    LineOut(x + 6, feetY + 4, x + 8, feetY + 3);
    LineOut(x + 2, feetY, x + 3, feetY);
    LineOut(x + 6, feetY, x + 7, feetY);
}

int HeroSpriteRow(int row)
{
    if (row == 0)
        return 0x24;
    if (row == 1)
        return 0x3C;
    if (row == 2)
        return 0x7E;
    if (row == 3)
        return 0xDB;
    if (row == 4)
        return 0x7E;
    if (row == 5)
        return 0x5A;
    if (row == 6)
        return 0x7E;
    return 0x3C;
}

int BearSpriteRow(int row)
{
    if (row == 0)
        return 0x3C;
    if (row == 1)
        return 0x7E;
    if (row == 2)
        return 0xFF;
    if (row == 3)
        return 0xDB;
    if (row == 4)
        return 0xFF;
    if (row == 5)
        return 0x7E;
    if (row == 6)
        return 0x3C;
    return 0x3C;
}

void DrawPixelSprite(int x, int feetY, bool isBear)
{
    int row;
    int column;
    int mask;
    int rows;

    rows = 8;
    for (row = 0; row < rows; row++)
    {
        if (isBear)
            mask = BearSpriteRow(row);
        else
            mask = HeroSpriteRow(row);

        for (column = 0; column < 8; column++)
        {
            if ((mask & (1 << column)) != 0)
                DrawBlock(x + column * 2, feetY + row * 2, 2, 2);
        }
    }
}

void DrawBarrelRun()
{
    ClearScreen();
    TextOut(10, 56, "BEAR RUN");
    TextOut(76, 56, "L");
    NumOut(88, 56, runnerLives);

    DrawPlatform(0, 98, 4);
    DrawPlatform(16, 56, 18);
    DrawPlatform(40, 86, 32);
    DrawPlatform(12, 90, 46);

    DrawPixelSprite(runnerX, runnerY, false);
    DrawPixelSprite(bearX, 46, true);
    RectOut(barrelX, barrelY, 6, 6);
    LineOut(barrelX + 1, barrelY + 1, barrelX + 4, barrelY + 4);
    LineOut(barrelX + 4, barrelY + 1, barrelX + 1, barrelY + 4);
    DrawBlock(58, 46, 8, 2);
    RectOut(60, 48, 4, 5);
}

void ResetBarrel()
{
    barrelX = 61;
    barrelY = 46;
    barrelVY = 0;
    barrelDirection = -1;
}

void PlayBarrelRun()
{
    int oldY;
    int landing;
    int gapX;
    int gapY;

    runnerX = 4;
    runnerY = 4;
    runnerVY = 0;
    runnerLives = 3;
    runnerScore = 0;
    frameCount = 0;
    runnerDone = false;
    bearX = 76;
    bearDirection = -1;
    bearClock = 0;
    ResetBarrel();

    while (runnerLives > 0 && !runnerDone)
    {
        DrawBarrelRun();

        if (ButtonPressed(BTNLEFT, false) && runnerX > 1)
            runnerX = runnerX - 2;
        if (ButtonPressed(BTNRIGHT, false) && runnerX < 82)
            runnerX = runnerX + 2;
        if (ButtonPressed(BTNCENTER, false) && IsSupported(runnerX, runnerY))
        {
            runnerVY = 6;
        }
        if (ButtonPressed(BTNEXIT, false))
        {
            while (ButtonPressed(BTNEXIT, false))
                Wait(25);
            return;
        }

        oldY = runnerY;
        runnerY = runnerY + runnerVY;
        if (runnerVY > -8)
            runnerVY--;
        if (runnerY < oldY)
        {
            landing = FindLanding(runnerX, oldY, runnerY);
            if (landing >= 0)
            {
                runnerY = landing;
                runnerVY = 0;
            }
        }
        if (runnerY < 4)
        {
            runnerY = 4;
            runnerVY = 0;
        }

        frameCount++;
        bearClock++;
        if (bearClock >= 6)
        {
            bearClock = 0;
            bearX = bearX + bearDirection * 2;
            if (bearX <= 68)
            {
                bearX = 68;
                bearDirection = 1;
            }
            else if (bearX >= 82)
            {
                bearX = 82;
                bearDirection = -1;
            }
        }

        if (frameCount % 4 == 0)
        {
            barrelX = barrelX + barrelDirection * 2;
            oldY = barrelY;
            if (!IsSupported(barrelX, barrelY))
            {
                barrelY = barrelY + barrelVY;
                if (barrelVY > -8)
                    barrelVY--;
                if (barrelY < oldY)
                {
                    landing = FindLanding(barrelX, oldY, barrelY);
                    if (landing >= 0)
                    {
                        barrelY = landing;
                        barrelVY = 0;
                    }
                }
            }

            if (barrelX < 2)
            {
                barrelDirection = 1;
                barrelX = 2;
            }
            if (barrelX > 92)
            {
                barrelDirection = -1;
                barrelX = 92;
            }
            runnerScore++;
        }

        gapX = runnerX - barrelX;
        gapY = runnerY - barrelY;
        if (gapX < 0)
            gapX = -gapX;
        if (gapY < 0)
            gapY = -gapY;
        if (gapX < 6 && gapY < 7)
        {
            runnerLives--;
            PlayTone(180, 120);
            runnerX = 4;
            runnerY = 4;
            runnerVY = 0;
            ResetBarrel();
        }

        gapX = runnerX - bearX;
        if (gapX < 0)
            gapX = -gapX;
        if (gapX < 10 && runnerY >= 59 && runnerVY < 0)
        {
            runnerDone = true;
            runnerScore = runnerScore + 100;
            PlayTone(880, 220);
        }
        else if (gapX < 10 && runnerY < 58)
        {
            runnerLives--;
            PlayTone(180, 120);
            runnerX = 4;
            runnerY = 4;
            runnerVY = 0;
            ResetBarrel();
        }

        Wait(90);
    }

    ClearScreen();
    if (runnerDone)
        TextOut(22, 42, "BEAR BEATEN");
    else
        TextOut(22, 42, "TRY AGAIN");
    TextOut(16, 26, "STEPS:");
    NumOut(58, 26, runnerScore);
    TextOut(8, 6, "ENTER:MENU");
    while (!ButtonPressed(BTNCENTER, false))
        Wait(25);
    while (ButtonPressed(BTNCENTER, false))
        Wait(25);
}

void DrawPocketLogo(int x, int y)
{
    DrawBlock(x, y + 15, 3, 14);
    DrawBlock(x + 3, y + 11, 3, 4);
    DrawBlock(x + 6, y + 8, 4, 3);
    DrawBlock(x + 10, y + 6, 25, 3);

    DrawBlock(x + 9, y + 15, 6, 13);
    DrawBlock(x + 10, y + 12, 4, 3);

    LineOut(x + 24, y + 28, x + 38, y + 28);
    LineOut(x + 22, y + 26, x + 22, y + 14);
    LineOut(x + 22, y + 14, x + 38, y + 14);
    LineOut(x + 27, y + 24, x + 36, y + 24);
    LineOut(x + 26, y + 23, x + 26, y + 16);
    LineOut(x + 27, y + 15, x + 36, y + 15);
    DrawBlock(x + 31, y + 18, 3, 3);
}

task main()
{
    int selection;
    bool changed;

    selection = 0;
    while (true)
    {
        ClearScreen();
        TextOut(17, 56, "NXT POCKET");
        DrawPocketLogo(2, 17);
        if (selection == 0)
            TextOut(42, 40, ">");
        TextOut(49, 40, "TETRAS");
        if (selection == 1)
            TextOut(42, 28, ">");
        TextOut(49, 28, "DUNGEON");
        if (selection == 2)
            TextOut(42, 16, ">");
        TextOut(49, 16, "BEAR RUN");
        TextOut(2, 3, "L/R SELECT  ENTER");

        changed = false;
        if (ButtonPressed(BTNLEFT, false))
        {
            selection = (selection + 2) % 3;
            changed = true;
        }
        else if (ButtonPressed(BTNRIGHT, false))
        {
            selection = (selection + 1) % 3;
            changed = true;
        }
        else if (ButtonPressed(BTNCENTER, false))
        {
            while (ButtonPressed(BTNCENTER, false))
                Wait(25);
            if (selection == 0)
            {
                ShowGameInstructions(0);
                PlayTetris();
            }
            else if (selection == 1)
            {
                ShowGameInstructions(1);
                PlayMazeBlaster();
            }
            else
            {
                ShowGameInstructions(2);
                PlayBarrelRun();
            }
            changed = true;
        }
        else if (ButtonPressed(BTNEXIT, false))
            Stop(true);

        if (changed)
        {
            Wait(220);
            changed = false;
        }
        Wait(35);
    }
}
